# Copy to .env on the server and fill in. Never commit .env.
# Generate each secret with:  openssl rand -hex 32

DB_PASSWORD=
JWT_SECRET=
INGEST_KEY=

# The public hostname, once its DNS A record points at the server, e.g.
#   DOMAIN=fleetpulse.example.com
# Leave empty to serve plain HTTP on the server's IP first.
DOMAIN=
